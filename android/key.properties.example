# --- Android Release Signing Configuration (Restaurants) ---
# This file is .gitignored - NEVER commit the real key.properties.
#
# Generate a new upload keystore:
#   keytool -genkeypair -v -keystore restaurants-upload-2026.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias restaurantsupload2026
#
# Export certificate for Play upload-key reset:
#   keytool -export -rfc -keystore restaurants-upload-2026.jks \
#     -alias restaurantsupload2026 -file restaurants-upload-2026-upload_certificate.pem

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=restaurantsupload2026
storeFile=../restaurants-upload-2026.jks
expectedSha1=YOUR_UPLOAD_KEY_SHA1
