{
    "compilerOptions": {
        "module": "Node16",
        "moduleResolution": "node16",
        "noImplicitReturns": true,
        "noUnusedLocals": true,
        "outDir": "lib",
        "rootDir": "src",
        "sourceMap": true,
        "strict": true,
        "target": "es2017",
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": [
            "node"
        ]
    },
    "compileOnSave": true,
    "include": [
        "src"
    ],
    "exclude": [
        "src/__tests__"
    ]
}